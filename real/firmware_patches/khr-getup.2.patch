+    if (g.x() != 0.0 || g.y() != 0.0 || g.z() != 0.0) { // I2C の読み取りに失敗すると全要素0になる → 渡さない
+      portENTER_CRITICAL(&khr_imu_mux);
+      khr_grav_shared[0] = (float)g.x();
+      khr_grav_shared[1] = (float)g.y();
+      khr_grav_shared[2] = (float)g.z();
+      khr_grav_seq++;
+      khr_imu_read_us = (uint16_t)(read_us > 65535u ? 65535u : read_us);
+      portEXIT_CRITICAL(&khr_imu_mux);
+    }
+#endif
+
     // 読み取り完了フラグをセット（メインloopが確認）
     imu_read_done = true;
   }
