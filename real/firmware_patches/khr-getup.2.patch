+#ifndef __KHR_CORE_H__
+#define __KHR_CORE_H__
+
+/// @file    khr_core.h
+/// @brief   [khr] khr_ext.h のうち Arduino に依存しない部分(通信監視の状態機械と状態語の組み立て).
+/// @details ホストの g++ で単体テストできる(khr_rl_tora/real/firmware_patches/test/test_khr_core.cpp).
+///          追加: khr_rl_tora (起き上がり実験の安全系 P0-2 と IMU の P0-1), 2026-10.
+
+#include <stdint.h>
+
+enum KhrWdgState : uint8_t {
+  KHR_WDG_DISARMED = 0, // 起動後, Power OFF のパケットをまだ受けていない: 全サーボ脱力
+  KHR_WDG_OK = 1,       // 正常
+  KHR_WDG_HOLD = 2,     // 途絶が timeout_ms 以上: 最後の目標角を保持(改造前と同じ挙動)
+  KHR_WDG_LIMP = 3      // 途絶が timeout_ms + hold_ms 以上: 全サーボ脱力. ラッチする
+};
+
+struct KhrWatchdog {
+  uint32_t timeout_ms;
+  uint32_t hold_ms;
+  uint8_t state = KHR_WDG_DISARMED;
+  uint32_t last_fresh_ms = 0;
+
+  KhrWatchdog(uint32_t a_timeout_ms, uint32_t a_hold_ms)
+      : timeout_ms(a_timeout_ms), hold_ms(a_hold_ms) {}
+
+  /// @brief 1フレームに1回呼び, 新しい状態を返す.
+  /// @param a_now_ms 現在時刻(millis()).
+  /// @param a_fresh このフレームでPCから正しい(チェックサムOKの)パケットを受けたか.
+  /// @param a_all_power_off そのパケットで, マウントされた全サーボの電源フラグが0か.
+  /// @details LIMP のラッチは「パケットが戻った」だけでは解けない. コンソールの Power を切った
+  ///          パケット(全サーボの電源フラグ0)が届いて初めて解ける. 解いたあと再び Power を入れる
+  ///          のはコンソールの通常手順に任せる(コンソールは Power ON の瞬間の実測角を目標にする)ので,
+  ///          脱力して崩れた姿勢から古い目標角へ跳ぶことはない.
+  ///          起動直後(DISARMED)も同じ条件で抜ける. 実験中に ESP32 が電圧降下などで再起動しても,
+  ///          コンソールが Power ON のまま送り続けている目標角へいきなり動き出さない.
+  ///          (コンソールは Power OFF で起動するので, 通常の起動手順は改造前と変わらない.)
+  uint8_t update(uint32_t a_now_ms, bool a_fresh, bool a_all_power_off) {
+    if (a_fresh) {
+      last_fresh_ms = a_now_ms;
+    }
+    const uint32_t silent_ms = a_now_ms - last_fresh_ms; // 符号なし減算なので millis() の桁あふれでも正しい
+
+    switch (state) {
+    case KHR_WDG_OK:
+    case KHR_WDG_HOLD:
+      if (silent_ms >= timeout_ms + hold_ms) {
+        state = KHR_WDG_LIMP;
+      } else if (silent_ms >= timeout_ms) {
+        state = KHR_WDG_HOLD;
+      } else {
+        state = KHR_WDG_OK;
+      }
+      break;
+    case KHR_WDG_DISARMED:
+    case KHR_WDG_LIMP:
+      if (a_fresh && a_all_power_off) {
+        state = KHR_WDG_OK;
+      }
+      break;
+    default: // ありえない値になったら安全側(脱力)へ
+      state = KHR_WDG_LIMP;
+      break;
+    }
+    return state;
+  }
+};
+
+#define KHR_STATUS_MAGIC 0x6B
+
+/// @brief 状態語 Meridim[11] を組み立てる. ビットの割り当ては khr_ext.h の冒頭を参照.
+///        PC 側の読み取りは khr_rl_tora/khr_common/gravity.py の decode_status().
+/// @param a_wdg_state 通信監視の状態(KhrWdgState).
+/// @param a_gravity_fresh このフレームで重力ベクトルを読めたか.
+/// @param a_wdg_enabled 通信監視が有効か.
+/// @param a_calib_stat BNO055 の CALIB_STAT レジスタの値(sys<<6 | gyro<<4 | accel<<2 | mag).
+inline uint16_t khr_pack_status(uint8_t a_wdg_state, bool a_gravity_fresh, bool a_wdg_enabled,
+                                uint8_t a_calib_stat) {
+  uint16_t status = (uint16_t)KHR_STATUS_MAGIC << 8;
+  status |= (uint16_t)(a_wdg_state & 0x03);
+  status |= (uint16_t)(a_gravity_fresh ? 1 : 0) << 2;
+  status |= (uint16_t)(a_wdg_enabled ? 1 : 0) << 3;
+  status |= (uint16_t)((a_calib_stat >> 2) & 0x03) << 4; // 加速度センサ
+  status |= (uint16_t)((a_calib_stat >> 6) & 0x03) << 6; // システム(融合)
+  return status;
+}
+
+#endif // __KHR_CORE_H__
