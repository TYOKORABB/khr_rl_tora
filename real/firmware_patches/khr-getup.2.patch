+#ifndef __KHR_EXT_H__
+#define __KHR_EXT_H__
+
+/// @file    khr_ext.h
+/// @brief   [khr] 起き上がり実験のための追加 (khr_rl_tora/real/firmware, 2026-10).
+/// @details 1) 通信監視: PCからの正しいパケットが途絶えたら, 保持 → 全サーボ脱力(ラッチ).
+///             起動直後も, コンソールの Power OFF のパケットを一度受けるまでは全サーボ脱力.
+///          2) IMU: BNO055 の融合推定の重力ベクトルを Meridim[8..10] に, 状態語を [11] に入れる.
+///             改造前のファームはこの4スロットに常に0を送っていた(地磁気・温度は読んでいない).
+///             Euler 角 [12..14] は改造前のまま送るので, 既存のコンソール・デプロイヤはそのまま動く.
+///
+///          状態語 Meridim[11] (unsigned short):
+///            bit 0-1  通信監視の状態 (0:DISARMED 1:OK 2:HOLD 3:LIMP)
+///            bit 2    前のフレームから新しい重力ベクトルが届いた(IMU スレッドが1周読み終えた)
+///            bit 3    通信監視が有効 (KHR_WDG_ENABLE)
+///            bit 4-5  BNO055 の加速度センサのキャリブレーション状態 (0-3)
+///            bit 6-7  BNO055 のシステム(融合)のキャリブレーション状態 (0-3)
+///            bit 8-15 0x6B (改造ファームの印. 改造前は [11] が常に0)
+///
+///          診断用 (khr-getup.2 から): Meridim[84] 重力ベクトルの通し番号(下位16bit), [85] IMU スレッド1周の読み取り時間(us).
+///            [86..87] は使わない(PC が往復遅れの測定に使う. ESP32 は受信した値をそのまま返す).
+
+#include "config.h"
+#include "main.h"
+#include "khr_core.h"
+
+KhrWatchdog khr_wdg(KHR_WDG_TIMEOUT_MS, KHR_WDG_HOLD_MS);
+
+bool khr_gravity_fresh = false; // 前のフレームから新しい重力ベクトルが届いたか
+uint32_t khr_grav_seq_sent = 0; // 前のフレームで送った重力ベクトルの通し番号
+
+/// @brief 受信した Meridim で, マウントされた全サーボの電源フラグが0か.
+bool khr_all_power_off(const Meridim90Union &a_meridim, const ServoParam &a_sv) {
+  for (int i = 0; i < a_sv.num_max; i++) {
+    if (a_sv.ixl_mount[i] && a_meridim.sval[i * 2 + MRD_L_ORIGIDX] != 0) {
+      return false;
+    }
+    if (a_sv.ixr_mount[i] && a_meridim.sval[i * 2 + MRD_R_ORIGIDX] != 0) {
+      return false;
+    }
+  }
+  return true;
+}
+
+/// @brief 起動時の設定表示.
+void khr_ext_hello() {
+  Serial.print("[khr] watchdog: ");
+  if (KHR_WDG_ENABLE) {
+    Serial.print("ON (hold after ");
+    Serial.print(KHR_WDG_TIMEOUT_MS);
+    Serial.print(" ms, limp after ");
+    Serial.print(KHR_WDG_TIMEOUT_MS + KHR_WDG_HOLD_MS);
+    Serial.println(" ms)");
+  } else {
+    Serial.println("OFF");
+  }
+  Serial.print("[khr] gravity vector -> Meridim[8..10]: ");
+  Serial.println(KHR_SEND_GRAVITY ? "ON" : "OFF");
+  Serial.print("[khr] BNO055 fusion mode: 0x");
+  Serial.println((int)KHR_BNO055_MODE, HEX);
+}
+
+/// @brief 通信監視を1フレーム進め, LIMP なら全サーボの電源フラグを0にする.
+/// @param a_meridim サーボ駆動に使う送信用 Meridim (s_udp_meridim).
+/// @param a_received PCから受信した Meridim (r_udp_meridim). 電源フラグの判定に使う.
+///        マスターコマンドは送信用の配列を書き換えることがあるので, 判定は受信した配列で行う.
+/// @param a_sv サーボパラメータ.
+/// @param a_fresh このフレームでPCから正しいパケットを受けたか.
+/// @details マスターコマンド第2群の後, [7] でサーボ目標を読む前に呼ぶ.
+void khr_wdg_step(Meridim90Union &a_meridim, const Meridim90Union &a_received,
+                  const ServoParam &a_sv, bool a_fresh) {
+  if (!KHR_WDG_ENABLE) {
+    return;
+  }
+  const uint8_t prev = khr_wdg.state;
+  const bool all_off = a_fresh && khr_all_power_off(a_received, a_sv);
+  const uint8_t state = khr_wdg.update(millis(), a_fresh, all_off);
+
+  if (state != prev) { // 状態が変わったときだけ表示する
+    static const char *names[] = {"DISARMED", "OK", "HOLD", "LIMP"};
+    Serial.print("[khr] watchdog ");
+    Serial.print(names[prev & 0x03]);
+    Serial.print(" -> ");
+    Serial.println(names[state & 0x03]);
+    if (state == KHR_WDG_LIMP) {
+      Serial.println("[khr] all servos limp. Turn console 'Power' OFF to release, then ON again.");
+    }
+  }
+
+  if (state == KHR_WDG_LIMP || state == KHR_WDG_DISARMED) {
+    for (int i = 0; i < MRD_SERVO_SLOTS; i++) {
+      a_meridim.sval[i * 2 + MRD_L_ORIGIDX] = 0; // 電源フラグ0 → [8] で ICS の setFree(脱力)
+      a_meridim.sval[i * 2 + MRD_R_ORIGIDX] = 0;
+    }
+  }
+}
+
+/// @brief 重力ベクトルを Meridim[8..10] に, 状態語を [11] に入れる.
+/// @details meriput90_ahrs() の直後に呼ぶ(あちらが [8..11] に0を書くので上書きする).
+void khr_meriput90_ext(Meridim90Union &a_meridim) {
+#if KHR_SEND_GRAVITY
+  float g[3];
+  uint32_t seq;
+  uint16_t read_us;
+  portENTER_CRITICAL(&khr_imu_mux); // IMU スレッドが読み終えた値だけを取る(mrd_wire0.h)
+  g[0] = khr_grav_shared[0];
+  g[1] = khr_grav_shared[1];
+  g[2] = khr_grav_shared[2];
+  seq = khr_grav_seq;
+  read_us = khr_imu_read_us;
+  portEXIT_CRITICAL(&khr_imu_mux);
+  khr_gravity_fresh = (seq != khr_grav_seq_sent); // 新しくなければ前回と同じ値を送る
+  khr_grav_seq_sent = seq;
+  a_meridim.sval[MRD_MAG_X] = mrd.float2HfShort(g[0]); // 100倍値(0.01 m/s^2 刻み)
+  a_meridim.sval[MRD_MAG_Y] = mrd.float2HfShort(g[1]);
+  a_meridim.sval[MRD_MAG_Z] = mrd.float2HfShort(g[2]);
+  a_meridim.usval[MRD_USERDATA_84] = (uint16_t)seq;   // 診断用: PC で更新の頻度・抜けを数える
+  a_meridim.usval[MRD_USERDATA_85] = read_us;         // 診断用: IMU スレッドの読み取り時間
+#endif
+  a_meridim.usval[MRD_TEMP] = khr_pack_status(khr_wdg.state, khr_gravity_fresh, KHR_WDG_ENABLE, khr_calib_stat);
+}
+
+#endif // __KHR_EXT_H__
