diff -ruN drain_base/Meridian_LITE_for_ESP32/src/khr_udp_drain.h drainonly/Meridian_LITE_for_ESP32/src/khr_udp_drain.h
--- drain_base/Meridian_LITE_for_ESP32/src/khr_udp_drain.h	1970-01-01 09:00:00.000000000 +0900
+++ drainonly/Meridian_LITE_for_ESP32/src/khr_udp_drain.h	2026-11-20 16:52:54.173174533 +0900
@@ -0,0 +1,53 @@
+#ifndef __KHR_UDP_DRAIN_H__
+#define __KHR_UDP_DRAIN_H__
+
+/// @file    khr_udp_drain.h
+/// @brief   受信バッファに溜まった古い通常パケットを読み捨て, 最新だけを使う (khr_rl_tora, 2026-10-13 / 単独パッチ 2026-11-20).
+/// @details メインループは 1 フレーム (10 ms) に受信バッファから一番古いパケットを 1 つだけ読む.
+///          PC が 100 Hz で送ると, 無線の都合で束になって届いた分が溜まったまま減らず, 指令が数フレーム遅れて使われる
+///          (実測: 往復の遅れ 中央値 52〜61 ms). 受けたあとに溜まっている通常パケットを読み捨て, 最新だけを残す.
+///          特殊コマンド (マスターコマンド [0] が Meridim の長さ 90 以外: 脱力・トリム設定など) は読み捨てない.
+///          Arduino に依存しないので, ホストの g++ で単体テストできる (test/test_udp_drain.cpp).
+
+#include <stdint.h>
+#include <string.h>
+
+#define KHR_MRDM_LEN  90 // Meridim の長さ (= 通常パケットのマスターコマンド [0])
+#define KHR_DRAIN_MAX 16 // 1 フレームに読み捨てる上限
+
+/// @brief Meridian のチェックサム (Meridian::cksm_rslt と同じ計算) が合っているか.
+inline bool khr_cksm_ok(const int16_t *a_m) {
+  int sum = 0;
+  for (int i = 0; i < KHR_MRDM_LEN - 1; i++) {
+    sum += (int)a_m[i];
+  }
+  return (int16_t)(~sum) == a_m[KHR_MRDM_LEN - 1];
+}
+
+/// @brief 受信バッファに溜まった通常パケットを読み捨て, a_cur を最新にする.
+/// @param a_cur いま受けたパケット (int16 の Meridim). 最新のパケットで上書きされる.
+/// @param a_recv 次のパケットを引数の配列に読めたら true を返す受信関数 (無ければ false).
+/// @param a_prev_seq 読み捨てたとき, 残したパケットの 1 つ前に持っていたパケットのシーケンス番号 [1].
+///        呼び出し側はこれをシーケンス番号の予想値に入れ, 読み捨てた分をスキップとして数えないようにする.
+/// @return 読み捨てた数 (0 なら a_cur も a_prev_seq も変えない).
+/// @details a_cur が特殊コマンドなら何もしない. 特殊コマンドが来たらそれを a_cur にしてそこで止める (後ろは次のフレーム).
+///          チェックサムが合わないパケットは捨てて続ける (その番号は飛びとして残る).
+template <class Recv>
+int khr_udp_drain(int16_t *a_cur, Recv a_recv, uint16_t &a_prev_seq, int a_max = KHR_DRAIN_MAX) {
+  int drained = 0;
+  int16_t next[KHR_MRDM_LEN];
+  for (int k = 0; k < a_max && a_cur[0] == KHR_MRDM_LEN; k++) {
+    if (!a_recv(next)) {
+      break;
+    }
+    if (!khr_cksm_ok(next)) {
+      continue;
+    }
+    a_prev_seq = (uint16_t)a_cur[1];
+    memcpy(a_cur, next, sizeof(next));
+    drained++;
+  }
+  return drained;
+}
+
+#endif // __KHR_UDP_DRAIN_H__
