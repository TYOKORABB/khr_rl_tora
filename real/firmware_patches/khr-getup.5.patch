+#endif // __KHR_CORE_H__
diff -ruN '--exclude=.pio' '--exclude=keys.h' '--exclude=*.orig' base/Meridian_LITE_for_ESP32/src/khr_ext.h dev/Meridian_LITE_for_ESP32/src/khr_ext.h
--- a/Meridian_LITE_for_ESP32/src/khr_ext.h
+++ b/Meridian_LITE_for_ESP32/src/khr_ext.h
@@ -0,0 +1,250 @@
+#ifndef __KHR_EXT_H__
+#define __KHR_EXT_H__
+
+/// @file    khr_ext.h
+/// @brief   [khr] 起き上がり実験のための追加 (khr_rl_tora/real/firmware, 2026-10).
+/// @details 1) 通信監視: PCからの正しいパケットが途絶えたら, 保持 → 全サーボ脱力(ラッチ).
+///             起動直後も, コンソールの Power OFF のパケットを一度受けるまでは全サーボ脱力.
+///          2) IMU: BNO055 の融合推定の重力ベクトルを Meridim[8..10] に, 状態語を [11] に入れる.
+///             改造前のファームはこの4スロットに常に0を送っていた(地磁気・温度は読んでいない).
+///             Euler 角 [12..14] は改造前のまま送るので, 既存のコンソール・デプロイヤはそのまま動く.
+///
+///          状態語 Meridim[11] (unsigned short):
+///            bit 0-1  通信監視の状態 (0:DISARMED 1:OK 2:HOLD 3:LIMP)
+///            bit 2    前のフレームから新しい重力ベクトルが届いた(IMU スレッドが1周読み終えた)
+///            bit 3    通信監視が有効 (KHR_WDG_ENABLE)
+///            bit 4-5  BNO055 の加速度センサのキャリブレーション状態 (0-3)
+///            bit 6-7  BNO055 のシステム(融合)のキャリブレーション状態 (0-3)
+///            bit 8-15 0x6B (改造ファームの印. 改造前は [11] が常に0)
+///
+///          診断用 (khr-getup.2 から): Meridim[84] 重力ベクトルの通し番号(下位16bit), [85] IMU スレッド1周の読み取り時間(us).
+///            [87] (khr-getup.3 から) IMU の診断語: bit 0-7 読み取りの失敗の累計, bit 8-11 最後の失敗の理由,
+///                 bit 12-13 読み取り方(0: 一括, 1: 梶田版と同じ個別). khr_core.h の khr_pack_imu_diag().
+///            [86] は使わない(PC が往復遅れの測定に使う. ESP32 は受信した値をそのまま返す).
+///          PC → ESP32: [87] に 0x6B4C を送っている間は, IMU を梶田版と同じ個別の読み取りにする(比較用).
+///          3) 受信 (khr-getup.4 から): 受信バッファに溜まった古い通常パケットを読み捨て, 最新だけを使う(KHR_UDP_DRAIN).
+///          4) サーボの読み出し (khr-getup.5 から): 肩・肘の電流・温度, 全サーボの設定を読むだけ(KHR_SERVO_TEL). 枠は khr_core.h.
+
+#include "config.h"
+#include "main.h"
+#include "khr_core.h"
+
+KhrWatchdog khr_wdg(KHR_WDG_TIMEOUT_MS, KHR_WDG_HOLD_MS);
+
+bool khr_gravity_fresh = false; // 前のフレームから新しい重力ベクトルが届いたか
+uint32_t khr_grav_seq_sent = 0; // 前のフレームで送った重力ベクトルの通し番号
+
+/// @brief 受信した Meridim で, マウントされた全サーボの電源フラグが0か.
+bool khr_all_power_off(const Meridim90Union &a_meridim, const ServoParam &a_sv) {
+  for (int i = 0; i < a_sv.num_max; i++) {
+    if (a_sv.ixl_mount[i] && a_meridim.sval[i * 2 + MRD_L_ORIGIDX] != 0) {
+      return false;
+    }
+    if (a_sv.ixr_mount[i] && a_meridim.sval[i * 2 + MRD_R_ORIGIDX] != 0) {
+      return false;
+    }
+  }
+  return true;
+}
+
+/// @brief [2-1] で受けたあと, 受信バッファに溜まった古い通常パケットを読み捨てて最新だけを残す(khr-getup.4).
+/// @return 読み捨てた数. 1 以上なら a_prev_seq に, 残したパケットの1つ前のシーケンス番号.
+int khr_udp_drain_rx(Meridim90Union &a_received, WiFiUDP &a_udp, uint16_t &a_prev_seq) {
+  return khr_udp_drain(
+      a_received.sval, [&a_udp](int16_t *a_dst) { return mrd_wifi_udp_receive((byte *)a_dst, MRDM_BYTE, a_udp); },
+      a_prev_seq);
+}
+
+/// @brief PC からの診断用の指定を反映する(正しいパケットを受けたフレームだけ).
+void khr_pc_options(const Meridim90Union &a_received, bool a_fresh) {
+#if KHR_SEND_GRAVITY && KHR_IMU_BURST
+  if (a_fresh) {
+    khr_imu_mode = (a_received.usval[MRD_USERDATA_87] == KHR_IMU_LEGACY_MAGIC) ? KHR_IMU_MODE_LEGACY
+                                                                               : KHR_IMU_MODE_BURST;
+  }
+#else
+  (void)a_received;
+  (void)a_fresh;
+#endif
+}
+
+/// @brief 起動時の設定表示.
+void khr_ext_hello() {
+  Serial.print("[khr] watchdog: ");
+  if (KHR_WDG_ENABLE) {
+    Serial.print("ON (hold after ");
+    Serial.print(KHR_WDG_TIMEOUT_MS);
+    Serial.print(" ms, limp after ");
+    Serial.print(KHR_WDG_TIMEOUT_MS + KHR_WDG_HOLD_MS);
+    Serial.println(" ms)");
+  } else {
+    Serial.println("OFF");
+  }
+  Serial.print("[khr] gravity vector -> Meridim[8..10]: ");
+  Serial.println(KHR_SEND_GRAVITY ? "ON" : "OFF");
+  Serial.print("[khr] BNO055 fusion mode: 0x");
+  Serial.println((int)KHR_BNO055_MODE, HEX);
+  Serial.print("[khr] UDP receive: ");
+  Serial.println(KHR_UDP_DRAIN ? "newest packet (drain older normal packets)" : "oldest packet (kajita)");
+  Serial.print("[khr] IMU read: ");
+  Serial.println((KHR_SEND_GRAVITY && KHR_IMU_BURST) ? "burst 0x08-0x33 (44 bytes, 1 transaction)" : "per vector (kajita)");
+  Serial.print("[khr] servo telemetry (read only) -> Meridim[42..49,72..74]: ");
+  Serial.println(KHR_SERVO_TEL ? "ON (current: L/R shoulder+elbow pitch every frame, temp 1/25, params of free servos 1/4)" : "OFF");
+}
+
+/// @brief 通信監視を1フレーム進め, LIMP なら全サーボの電源フラグを0にする.
+/// @param a_meridim サーボ駆動に使う送信用 Meridim (s_udp_meridim).
+/// @param a_received PCから受信した Meridim (r_udp_meridim). 電源フラグの判定に使う.
+///        マスターコマンドは送信用の配列を書き換えることがあるので, 判定は受信した配列で行う.
+/// @param a_sv サーボパラメータ.
+/// @param a_fresh このフレームでPCから正しいパケットを受けたか.
+/// @details マスターコマンド第2群の後, [7] でサーボ目標を読む前に呼ぶ.
+void khr_wdg_step(Meridim90Union &a_meridim, const Meridim90Union &a_received,
+                  const ServoParam &a_sv, bool a_fresh) {
+  if (!KHR_WDG_ENABLE) {
+    return;
+  }
+  const uint8_t prev = khr_wdg.state;
+  const bool all_off = a_fresh && khr_all_power_off(a_received, a_sv);
+  const uint8_t state = khr_wdg.update(millis(), a_fresh, all_off);
+
+  if (state != prev) { // 状態が変わったときだけ表示する
+    static const char *names[] = {"DISARMED", "OK", "HOLD", "LIMP"};
+    Serial.print("[khr] watchdog ");
+    Serial.print(names[prev & 0x03]);
+    Serial.print(" -> ");
+    Serial.println(names[state & 0x03]);
+    if (state == KHR_WDG_LIMP) {
+      Serial.println("[khr] all servos limp. Turn console 'Power' OFF to release, then ON again.");
+    }
+  }
+
+  if (state == KHR_WDG_LIMP || state == KHR_WDG_DISARMED) {
+    for (int i = 0; i < MRD_SERVO_SLOTS; i++) {
+      a_meridim.sval[i * 2 + MRD_L_ORIGIDX] = 0; // 電源フラグ0 → [8] で ICS の setFree(脱力)
+      a_meridim.sval[i * 2 + MRD_R_ORIGIDX] = 0;
+    }
+  }
+}
+
+/// @brief 重力ベクトルを Meridim[8..10] に, 状態語を [11] に入れる.
+/// @details meriput90_ahrs() の直後に呼ぶ(あちらが [8..11] に0を書くので上書きする).
+void khr_meriput90_ext(Meridim90Union &a_meridim) {
+#if KHR_SEND_GRAVITY
+  float g[3];
+  uint32_t seq, fail_count;
+  uint16_t read_us;
+  uint8_t fail_reason;
+  portENTER_CRITICAL(&khr_imu_mux); // IMU スレッドが読み終えた値だけを取る(mrd_wire0.h)
+  g[0] = khr_grav_shared[0];
+  g[1] = khr_grav_shared[1];
+  g[2] = khr_grav_shared[2];
+  seq = khr_grav_seq;
+  read_us = khr_imu_read_us;
+  fail_count = khr_imu_fail_count;
+  fail_reason = khr_imu_fail_reason;
+  portEXIT_CRITICAL(&khr_imu_mux);
+  khr_gravity_fresh = (seq != khr_grav_seq_sent); // 新しくなければ前回と同じ値を送る
+  khr_grav_seq_sent = seq;
+  a_meridim.sval[MRD_MAG_X] = mrd.float2HfShort(g[0]); // 100倍値(0.01 m/s^2 刻み)
+  a_meridim.sval[MRD_MAG_Y] = mrd.float2HfShort(g[1]);
+  a_meridim.sval[MRD_MAG_Z] = mrd.float2HfShort(g[2]);
+  a_meridim.usval[MRD_USERDATA_84] = (uint16_t)seq;   // 診断用: PC で更新の頻度・抜けを数える
+  a_meridim.usval[MRD_USERDATA_85] = read_us;         // 診断用: IMU スレッドの読み取り時間
+  a_meridim.usval[MRD_USERDATA_87] = khr_pack_imu_diag(fail_count, fail_reason, khr_imu_mode); // 診断用
+#endif
+  a_meridim.usval[MRD_TEMP] = khr_pack_status(khr_wdg.state, khr_gravity_fresh, KHR_WDG_ENABLE, khr_calib_stat);
+}
+
+// ---- サーボの電流・温度・設定の読み出し(khr-getup.5) ------------------------------------------------------
+#if KHR_SERVO_TEL
+KhrParamCache khr_pcache = {};
+int16_t khr_tel_cur[KHR_TEL_NSV] = {-1, -1, -1, -1};
+uint16_t khr_tel_tmp_word = KHR_TEL_NA;
+uint32_t khr_tel_frame = 0, khr_tel_fail = 0;
+uint16_t khr_tel_us = 0;
+int khr_tel_ppos = 0, khr_tel_pcur = 0;
+
+/// @brief ICS の EEPROM の 64 バイトを読む(読み出しのコマンド 0xA0+ID, サブコマンド 0x00. 書き込みはしない).
+bool khr_ics_read_eeprom(IcsHardSerialClass &a_ics, uint8_t a_id, uint8_t *a_out) {
+  byte tx[2] = {(byte)(0xA0 + a_id), 0x00};
+  byte rx[66];
+  if (!a_ics.synchronize(tx, 2, rx, 66)) {
+    return false;
+  }
+  if ((rx[0] & 0x1F) != a_id || rx[1] != 0x00) { // 返事の ID とサブコマンドを確かめる
+    return false;
+  }
+  memcpy(a_out, rx + 2, 64);
+  return true;
+}
+
+/// @brief [8-1] のサーボの駆動の直後に呼ぶ. 肩・肘の電流(毎フレーム)と温度(25 フレームに 1 個), 脱力中のサーボの設定(4 フレームに 1 個)を読む.
+void khr_servo_tel_read(const Meridim90Union &a_meridim, ServoParam &a_sv) {
+  unsigned long t0 = micros();
+  for (int k = 0; k < KHR_TEL_NSV; k++) {
+    uint8_t l = KHR_TEL_LINE[k], i = KHR_TEL_IDX[k];
+    IcsHardSerialClass &ics = l ? ics_R : ics_L;
+    int v = ics.getCur((byte)(l ? a_sv.ixr_id[i] : a_sv.ixl_id[i]));
+    if (v < 0) {
+      khr_tel_fail++;
+    }
+    khr_tel_cur[k] = (int16_t)v;
+  }
+  if (khr_tel_frame % KHR_TEL_TMP_EVERY == 0) {
+    uint8_t k = (uint8_t)((khr_tel_frame / KHR_TEL_TMP_EVERY) % KHR_TEL_NSV);
+    uint8_t l = KHR_TEL_LINE[k], i = KHR_TEL_IDX[k];
+    IcsHardSerialClass &ics = l ? ics_R : ics_L;
+    int v = ics.getTmp((byte)(l ? a_sv.ixr_id[i] : a_sv.ixl_id[i]));
+    if (v < 0) {
+      khr_tel_fail++;
+    }
+    khr_tel_tmp_word = khr_tel_pack_tmp(k, v);
+  }
+  if (khr_tel_frame % KHR_TEL_PARAM_EVERY == 0) {
+    auto is_free = [&](int l, int i) {   // 送った指令が脱力(電源フラグ 0)のサーボだけ読む
+      bool mounted = l ? a_sv.ixr_mount[i] : a_sv.ixl_mount[i];
+      return mounted && a_meridim.sval[i * 2 + (l ? MRD_R_ORIGIDX : MRD_L_ORIGIDX)] == 0;
+    };
+    uint8_t l, i;
+    if (khr_param_pick(khr_pcache, khr_tel_pcur, is_free, l, i)) {
+      IcsHardSerialClass &ics = l ? ics_R : ics_L;
+      uint8_t id = (uint8_t)(l ? a_sv.ixr_id[i] : a_sv.ixl_id[i]);
+      int st = ics.getStrc(id);
+      int sp = ics.getSpd(id);
+      bool ok = st >= 0 && sp >= 0 && khr_ics_read_eeprom(ics, id, khr_pcache.eep[l][i]);
+      if (ok) {
+        khr_pcache.strc[l][i] = (uint8_t)st;
+        khr_pcache.spd[l][i] = (uint8_t)sp;
+        khr_pcache.valid[l][i] = true;
+      } else {
+        khr_tel_fail++;
+      }
+    }
+  }
+  khr_tel_us = (uint16_t)min((unsigned long)65535, micros() - t0);
+  khr_tel_frame++;
+}
+
+/// @brief 読んだ値を Meridim に入れる. [9-1] が使っていない枠に受信の値を書き戻すので, その後(khr_meriput90_ext の直後)に呼ぶ.
+void khr_servo_tel_put(Meridim90Union &a_meridim) {
+  a_meridim.usval[KHR_TEL_SLOT_HDR] = (uint16_t)((KHR_TEL_MAGIC << 8) | (khr_tel_frame & 0xFF));
+  for (int k = 0; k < KHR_TEL_NSV; k++) {
+    a_meridim.usval[KHR_TEL_SLOT_CUR + k] = khr_tel_cur[k] < 0 ? (uint16_t)KHR_TEL_NA : (uint16_t)khr_tel_cur[k];
+  }
+  a_meridim.usval[KHR_TEL_SLOT_TMP] = khr_tel_tmp_word;
+  uint8_t l, i, item;
+  if (khr_param_next(khr_pcache, khr_tel_ppos, l, i, item)) {
+    a_meridim.usval[KHR_TEL_SLOT_PHDR] = khr_tel_pack_phdr(l, i, item);
+    a_meridim.usval[KHR_TEL_SLOT_PVAL] = khr_param_item(khr_pcache, l, i, item);
+  } else {
+    a_meridim.usval[KHR_TEL_SLOT_PHDR] = KHR_TEL_NA;
+    a_meridim.usval[KHR_TEL_SLOT_PVAL] = KHR_TEL_NA;
+  }
+  a_meridim.usval[KHR_TEL_SLOT_US] = khr_tel_us;
+  a_meridim.usval[KHR_TEL_SLOT_FAIL] = (uint16_t)khr_tel_fail;
+  a_meridim.usval[KHR_TEL_SLOT_DONE] = (uint16_t)khr_param_done(khr_pcache);
+}
+#endif
+
+#endif // __KHR_EXT_H__
