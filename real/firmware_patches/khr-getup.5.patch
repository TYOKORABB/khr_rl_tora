+#ifndef __KHR_CORE_H__
+#define __KHR_CORE_H__
+
+/// @file    khr_core.h
+/// @brief   [khr] khr_ext.h のうち Arduino に依存しない部分(通信監視の状態機械と状態語の組み立て).
+/// @details ホストの g++ で単体テストできる(khr_rl_tora/real/firmware_patches/test/test_khr_core.cpp).
+///          追加: khr_rl_tora (起き上がり実験の安全系 P0-2 と IMU の P0-1), 2026-10.
+
+#include <stdint.h>
+#include <string.h>
+
+enum KhrWdgState : uint8_t {
+  KHR_WDG_DISARMED = 0, // 起動後, Power OFF のパケットをまだ受けていない: 全サーボ脱力
+  KHR_WDG_OK = 1,       // 正常
+  KHR_WDG_HOLD = 2,     // 途絶が timeout_ms 以上: 最後の目標角を保持(改造前と同じ挙動)
+  KHR_WDG_LIMP = 3      // 途絶が timeout_ms + hold_ms 以上: 全サーボ脱力. ラッチする
+};
+
+struct KhrWatchdog {
+  uint32_t timeout_ms;
+  uint32_t hold_ms;
+  uint8_t state = KHR_WDG_DISARMED;
+  uint32_t last_fresh_ms = 0;
+
+  KhrWatchdog(uint32_t a_timeout_ms, uint32_t a_hold_ms)
+      : timeout_ms(a_timeout_ms), hold_ms(a_hold_ms) {}
+
+  /// @brief 1フレームに1回呼び, 新しい状態を返す.
+  /// @param a_now_ms 現在時刻(millis()).
+  /// @param a_fresh このフレームでPCから正しい(チェックサムOKの)パケットを受けたか.
+  /// @param a_all_power_off そのパケットで, マウントされた全サーボの電源フラグが0か.
+  /// @details LIMP のラッチは「パケットが戻った」だけでは解けない. コンソールの Power を切った
+  ///          パケット(全サーボの電源フラグ0)が届いて初めて解ける. 解いたあと再び Power を入れる
+  ///          のはコンソールの通常手順に任せる(コンソールは Power ON の瞬間の実測角を目標にする)ので,
+  ///          脱力して崩れた姿勢から古い目標角へ跳ぶことはない.
+  ///          起動直後(DISARMED)も同じ条件で抜ける. 実験中に ESP32 が電圧降下などで再起動しても,
+  ///          コンソールが Power ON のまま送り続けている目標角へいきなり動き出さない.
+  ///          (コンソールは Power OFF で起動するので, 通常の起動手順は改造前と変わらない.)
+  uint8_t update(uint32_t a_now_ms, bool a_fresh, bool a_all_power_off) {
+    if (a_fresh) {
+      last_fresh_ms = a_now_ms;
+    }
+    const uint32_t silent_ms = a_now_ms - last_fresh_ms; // 符号なし減算なので millis() の桁あふれでも正しい
+
+    switch (state) {
+    case KHR_WDG_OK:
+    case KHR_WDG_HOLD:
+      if (silent_ms >= timeout_ms + hold_ms) {
+        state = KHR_WDG_LIMP;
+      } else if (silent_ms >= timeout_ms) {
+        state = KHR_WDG_HOLD;
+      } else {
+        state = KHR_WDG_OK;
+      }
+      break;
+    case KHR_WDG_DISARMED:
+    case KHR_WDG_LIMP:
+      if (a_fresh && a_all_power_off) {
+        state = KHR_WDG_OK;
+      }
+      break;
+    default: // ありえない値になったら安全側(脱力)へ
+      state = KHR_WDG_LIMP;
+      break;
+    }
+    return state;
+  }
+};
+
+#define KHR_STATUS_MAGIC 0x6B
+
+/// @brief 状態語 Meridim[11] を組み立てる. ビットの割り当ては khr_ext.h の冒頭を参照.
+///        PC 側の読み取りは khr_rl_tora/khr_common/gravity.py の decode_status().
+/// @param a_wdg_state 通信監視の状態(KhrWdgState).
+/// @param a_gravity_fresh このフレームで重力ベクトルを読めたか.
+/// @param a_wdg_enabled 通信監視が有効か.
+/// @param a_calib_stat BNO055 の CALIB_STAT レジスタの値(sys<<6 | gyro<<4 | accel<<2 | mag).
+inline uint16_t khr_pack_status(uint8_t a_wdg_state, bool a_gravity_fresh, bool a_wdg_enabled,
+                                uint8_t a_calib_stat) {
+  uint16_t status = (uint16_t)KHR_STATUS_MAGIC << 8;
+  status |= (uint16_t)(a_wdg_state & 0x03);
+  status |= (uint16_t)(a_gravity_fresh ? 1 : 0) << 2;
+  status |= (uint16_t)(a_wdg_enabled ? 1 : 0) << 3;
+  status |= (uint16_t)((a_calib_stat >> 2) & 0x03) << 4; // 加速度センサ
+  status |= (uint16_t)((a_calib_stat >> 6) & 0x03) << 6; // システム(融合)
+  return status;
+}
+
+// ---- BNO055 の一括読み取り(khr-getup.3) ----------------------------------------------------------
+// 加速度(0x08)から重力(0x2E)までの 44 バイトを 1 回の I2C 読み取りで取る. 同じ融合周期の値がそろい,
+// 個別に 4 回読むより I2C の回数が減る. レジスタの並びは BNO055 のデータシート 4.2(page 0).
+#define KHR_BNO_BURST_ADDR 0x08 // ACC_DATA_X_LSB
+#define KHR_BNO_BURST_LEN  44   // 0x08..0x33
+#define KHR_BNO_OFS_ACC    0    // 0x08 加速度  1 m/s^2 = 100 LSB
+#define KHR_BNO_OFS_GYR    12   // 0x14 ジャイロ 1 dps = 16 LSB
+#define KHR_BNO_OFS_EUL    18   // 0x1A Euler 角 1 deg = 16 LSB (heading, roll, pitch の順)
+#define KHR_BNO_OFS_GRV    38   // 0x2E 重力    1 m/s^2 = 100 LSB
+
+struct KhrImuSample {
+  double acc[3]; // m/s^2
+  double gyr[3]; // deg/s
+  double eul[3]; // deg
+  double grv[3]; // m/s^2
+};
+
+inline int16_t khr_le16(const uint8_t *a_p) {
+  return (int16_t)((uint16_t)a_p[0] | ((uint16_t)a_p[1] << 8));
+}
+
+/// @brief 一括読み取りの 44 バイトを物理量にする. 換算は Adafruit_BNO055::getVector() と同じ(double で割る).
+inline void khr_decode_bno_burst(const uint8_t *a_buf, KhrImuSample &a_s) {
+  for (int i = 0; i < 3; i++) {
+    a_s.acc[i] = (double)khr_le16(a_buf + KHR_BNO_OFS_ACC + 2 * i) / 100.0;
+    a_s.gyr[i] = (double)khr_le16(a_buf + KHR_BNO_OFS_GYR + 2 * i) / 16.0;
+    a_s.eul[i] = (double)khr_le16(a_buf + KHR_BNO_OFS_EUL + 2 * i) / 16.0;
+    a_s.grv[i] = (double)khr_le16(a_buf + KHR_BNO_OFS_GRV + 2 * i) / 100.0;
+  }
+}
+
+inline bool khr_all_zero(const uint8_t *a_buf, int a_len) {
+  for (int i = 0; i < a_len; i++) {
+    if (a_buf[i] != 0) {
+      return false;
+    }
+  }
+  return true;
+}
+
+// IMU の読み取り方(PC から Meridim[87] に KHR_IMU_LEGACY_MAGIC を送ると, 比較のため梶田版と同じ読み方に切り替わる)
+enum KhrImuMode : uint8_t {
+  KHR_IMU_MODE_BURST = 0,  // 一括読み取り(khr-getup.3 の既定)
+  KHR_IMU_MODE_LEGACY = 1  // 梶田版と同じ個別読み取り + 重力ベクトル(khr-getup.2 と同じ)
+};
+#define KHR_IMU_LEGACY_MAGIC 0x6B4C // 上位 0x6B は診断語(下)には現れない値
+
+// 読み取りに失敗した理由. 0〜8 は Arduino-ESP32 1.0.6 の i2c_err_t(Wire.lastError())
+enum : uint8_t {
+  KHR_IMU_FAIL_ZERO_ALL = 0xD,  // I2C は成功したが 44 バイトすべて 0
+  KHR_IMU_FAIL_SHORT = 0xE,     // 受け取ったバイト数が足りない(エラーコードなし)
+  KHR_IMU_FAIL_ZERO_GRAV = 0xF  // 重力ベクトルだけ全要素 0(ほかの値は使う)
+};
+
+/// @brief 診断語 Meridim[87] を組み立てる.
+///        bit 0-7 失敗の累計(下位 8 bit), bit 8-11 最後の失敗の理由, bit 12-13 読み取り方(KhrImuMode).
+inline uint16_t khr_pack_imu_diag(uint32_t a_fail_count, uint8_t a_last_reason, uint8_t a_mode) {
+  return (uint16_t)((a_fail_count & 0xFF) | ((uint16_t)(a_last_reason & 0x0F) << 8) |
+                    ((uint16_t)(a_mode & 0x03) << 12));
+}
+
+// ---- 受信バッファの読み捨て(khr-getup.4) -----------------------------------------------------------
+// 梶田版は受信バッファから毎フレーム一番古いパケットを1つだけ読むので, 溜まった分だけ PC の指令が遅れる
+// (2026-10-13 実測で往復 約 50 ms). 受けたあとに溜まっている通常パケットを読み捨て, 最新だけを使う.
+// 特殊コマンド(マスターコマンドが Meridim の長さ 90 以外: 脱力・トリム設定など)は読み捨てない.
+#define KHR_MRDM_LEN    90 // Meridim の長さ(= 通常パケットのマスターコマンド [0])
+#define KHR_DRAIN_MAX   16 // 1 フレームに読み捨てる上限
+
+/// @brief Meridian のチェックサム(Meridian::cksm_rslt と同じ計算)が合っているか.
+inline bool khr_cksm_ok(const int16_t *a_m) {
+  int sum = 0;
+  for (int i = 0; i < KHR_MRDM_LEN - 1; i++) {
+    sum += (int)a_m[i];
+  }
+  return (int16_t)(~sum) == a_m[KHR_MRDM_LEN - 1];
+}
+
+/// @brief 受信バッファに溜まった通常パケットを読み捨て, a_cur を最新にする.
+/// @param a_cur いま受けたパケット(int16 の Meridim). 最新のパケットで上書きされる.
+/// @param a_recv 次のパケットを引数の配列に読めたら true を返す受信関数(無ければ false).
+/// @param a_prev_seq 読み捨てたとき, 最後に残したパケットの1つ前に持っていたパケットのシーケンス番号 [1].
+/// @return 読み捨てた数(0 なら a_cur も a_prev_seq も変えない).
+/// @details a_cur が特殊コマンドなら何もしない. 特殊コマンドが来たらそれを a_cur にしてそこで止める(後ろは次のフレーム).
+///          チェックサムが合わないパケットは捨てて続ける.
+template <class Recv>
+int khr_udp_drain(int16_t *a_cur, Recv a_recv, uint16_t &a_prev_seq, int a_max = KHR_DRAIN_MAX) {
+  int drained = 0;
+  int16_t next[KHR_MRDM_LEN];
+  for (int k = 0; k < a_max && a_cur[0] == KHR_MRDM_LEN; k++) {
+    if (!a_recv(next)) {
+      break;
+    }
+    if (!khr_cksm_ok(next)) {
+      continue;
+    }
+    a_prev_seq = (uint16_t)a_cur[1];
+    memcpy(a_cur, next, sizeof(next));
+    drained++;
+  }
+  return drained;
+}
+
+// ---- サーボの電流・温度・設定の読み出し(khr-getup.5, 2026-11-07) ---------------------------------------
+// 起き上がりの実機で肩・肘が押したまま回りきらない原因(電源の電流の合計 / サーボのプロテクション / サーボ内の硬さ)を切り分けるため,
+// ICS の読み出しのコマンドだけを使って, 肩・肘のピッチ 4 個の電流と温度, 全サーボのストレッチ・スピード・EEPROM(64 バイト)を読む.
+// サーボの設定は書き換えない(書き込みのコマンドは送らない. 本人の決定 11/7: プロテクションは外さない).
+// 送り先は使っていないサーボの枠(L 11..14 = Meridim[42..49], R 11..14 = [72..79]). PC のデプロイヤは L0..10・R0..10 しか読まない.
+#define KHR_TEL_MAGIC     0x54   // [42] の上位 8 bit(改造前は PC の値をそのまま返していた)
+#define KHR_TEL_NSV       4      // 電流を毎フレーム読むサーボ: 左肩ピッチ, 左肘ピッチ, 右肩ピッチ, 右肘ピッチ
+#define KHR_TEL_TMP_EVERY 25     // 温度は 25 フレームに 1 回, 4 個を順に(1 個あたり 1 秒に 1 回)
+#define KHR_TEL_PARAM_EVERY 4    // 設定はこのフレームに 1 回, 脱力中のサーボを 1 個ずつ
+#define KHR_TEL_N_SERVO   11     // 1 系統のサーボの数(0..10)
+#define KHR_TEL_N_ITEMS   66     // 1 サーボの設定の項目: 0 ストレッチ, 1 スピード, 2..65 EEPROM の 0..63 バイト目
+#define KHR_TEL_NA        0xFFFF // 読めなかった・まだ無い
+
+#define KHR_TEL_SLOT_HDR  42 // [42] KHR_TEL_MAGIC << 8 | フレームの通し番号(下位 8 bit)
+#define KHR_TEL_SLOT_CUR  43 // [43..46] 電流の生の値(ICS: 0..63 正転, 64..127 逆転). 読めなければ 0xFFFF
+#define KHR_TEL_SLOT_TMP  47 // [47] bit 8-9 どのサーボか(0..3), bit 0-7 温度の生の値(1..127, 小さいほど高温). 読めなければ 0xFFFF
+#define KHR_TEL_SLOT_PHDR 48 // [48] 設定の項目: bit 15 系統(0:L 1:R), bit 8-11 サーボの番号(0..10), bit 0-6 項目(0..65). 無ければ 0xFFFF
+#define KHR_TEL_SLOT_PVAL 49 // [49] 設定の値(0..255)
+#define KHR_TEL_SLOT_US   72 // [72] このフレームの読み出しにかかった時間 [us]
+#define KHR_TEL_SLOT_FAIL 73 // [73] 読み出しの失敗の累計(下位 16 bit)
+#define KHR_TEL_SLOT_DONE 74 // [74] 設定を読み終えたサーボの数(0..22)
+
+const uint8_t KHR_TEL_LINE[KHR_TEL_NSV] = {0, 0, 1, 1}; // 0: L 系統, 1: R 系統
+const uint8_t KHR_TEL_IDX[KHR_TEL_NSV] = {1, 4, 1, 4};  // config.h の [01] 肩ピッチ, [04] 肘ピッチ
+
+inline uint16_t khr_tel_pack_phdr(uint8_t a_line, uint8_t a_idx, uint8_t a_item) {
+  return (uint16_t)(((a_line & 1u) << 15) | ((a_idx & 0x0Fu) << 8) | (a_item & 0x7Fu));
+}
+inline void khr_tel_unpack_phdr(uint16_t a_h, uint8_t &a_line, uint8_t &a_idx, uint8_t &a_item) {
+  a_line = (uint8_t)(a_h >> 15);
+  a_idx = (uint8_t)((a_h >> 8) & 0x0F);
+  a_item = (uint8_t)(a_h & 0x7F);
+}
+inline uint16_t khr_tel_pack_tmp(uint8_t a_k, int a_raw) {
+  return a_raw < 0 ? (uint16_t)KHR_TEL_NA : (uint16_t)(((a_k & 3u) << 8) | ((unsigned)a_raw & 0xFFu));
+}
+
+/// @brief 読み終えたサーボの設定(ストレッチ・スピード・EEPROM). valid のサーボだけを PC へ順に流す.
+struct KhrParamCache {
+  bool valid[2][KHR_TEL_N_SERVO];
+  uint8_t strc[2][KHR_TEL_N_SERVO];
+  uint8_t spd[2][KHR_TEL_N_SERVO];
+  uint8_t eep[2][KHR_TEL_N_SERVO][64];
+};
+
+inline uint8_t khr_param_item(const KhrParamCache &a_c, int a_line, int a_idx, int a_item) {
+  if (a_item == 0) {
+    return a_c.strc[a_line][a_idx];
+  }
+  if (a_item == 1) {
+    return a_c.spd[a_line][a_idx];
+  }
+  return a_c.eep[a_line][a_idx][a_item - 2];
+}
+
+inline int khr_param_done(const KhrParamCache &a_c) {
+  int n = 0;
+  for (int l = 0; l < 2; l++) {
+    for (int i = 0; i < KHR_TEL_N_SERVO; i++) {
+      n += a_c.valid[l][i] ? 1 : 0;
+    }
+  }
+  return n;
+}
+
+/// @brief 次に PC へ流す設定の項目. a_pos(0 .. 2*11*66-1 を巡回)を進め, 読み終えたサーボの項目だけを返す.
+/// @return 読み終えたサーボが1つも無ければ false.
+inline bool khr_param_next(const KhrParamCache &a_c, int &a_pos, uint8_t &a_line, uint8_t &a_idx, uint8_t &a_item) {
+  const int total = 2 * KHR_TEL_N_SERVO * KHR_TEL_N_ITEMS;
+  for (int k = 0; k < total; k++) {
+    int p = a_pos;
+    a_pos = (a_pos + 1) % total;
+    int sv = p / KHR_TEL_N_ITEMS;
+    int l = sv / KHR_TEL_N_SERVO, i = sv % KHR_TEL_N_SERVO;
+    if (a_c.valid[l][i]) {
+      a_line = (uint8_t)l;
+      a_idx = (uint8_t)i;
+      a_item = (uint8_t)(p % KHR_TEL_N_ITEMS);
+      return true;
+    }
+  }
+  return false;
+}
+
+/// @brief まだ読んでいないサーボのうち, a_free(l, i) が true(脱力中)のものを a_cursor から順に1つ選ぶ.
+template <class Free>
+inline bool khr_param_pick(const KhrParamCache &a_c, int &a_cursor, Free a_free, uint8_t &a_line, uint8_t &a_idx) {
+  const int total = 2 * KHR_TEL_N_SERVO;
+  for (int k = 0; k < total; k++) {
+    int p = a_cursor;
+    a_cursor = (a_cursor + 1) % total;
+    int l = p / KHR_TEL_N_SERVO, i = p % KHR_TEL_N_SERVO;
+    if (!a_c.valid[l][i] && a_free(l, i)) {
+      a_line = (uint8_t)l;
+      a_idx = (uint8_t)i;
+      return true;
+    }
+  }
+  return false;
+}
