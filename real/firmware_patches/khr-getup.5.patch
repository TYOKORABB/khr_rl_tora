diff -ruN '--exclude=.pio' '--exclude=keys.h' '--exclude=*.orig' base/Meridian_LITE_for_ESP32/src/khr_core.h dev/Meridian_LITE_for_ESP32/src/khr_core.h
--- a/Meridian_LITE_for_ESP32/src/khr_core.h
